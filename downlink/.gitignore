*.csv

# Python bytecode
__pycache__/
*.pyc

# macOS finder droppings
.DS_Store

# archive token, never committed
.zenodo-token

# generated: golden frames rebuild from the *_50k.txt specs,
# decoded bit streams from the captures
golden_*.txt
bits_*.txt
